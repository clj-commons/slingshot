{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.8.0"}}

 :aliases
 {;; versions to test against:
  :1.8  {:override-deps {org.clojure/clojure {:mvn/version "1.8.0"}}}
  :1.9  {:override-deps {org.clojure/clojure {:mvn/version "1.9.0"}}}
  :1.10 {:override-deps {org.clojure/clojure {:mvn/version "1.10.3"}}}
  :1.11 {:override-deps {org.clojure/clojure {:mvn/version "1.11.4"}}}
  :1.12 {:override-deps {org.clojure/clojure {:mvn/version "1.12.7"}}}
  :1.13 {:override-deps {org.clojure/clojure {:mvn/version "1.13.0-alpha11"}}}

  ;; running tests/checks of various kinds:
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}}
  :runner {:main-opts ["-m" "cognitect.test-runner"]}
  :neil {:project {:version "0.14.23"}}}}
